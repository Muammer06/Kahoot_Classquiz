# Loaded by Docker Compose into api / worker containers.
# See docker/run.sh for ROOT_ADDRESS & SECRET_KEY (set automatically).
#
# pydantic-settings: REGISTRATION_DISABLED -> registration_disabled

REGISTRATION_DISABLED=true
SKIP_EMAIL_VERIFICATION=true
GUEST_EMAIL=guest@classquiz.local
GUEST_USERNAME=guest

# Mail vars are required by Settings() but unused in anonymous mode.
MAIL_ADDRESS=noreply@localhost
MAIL_USERNAME=noreply@localhost
MAIL_PASSWORD=anonymous-mode-unused
MAIL_SERVER=127.0.0.1
MAIL_PORT=25
